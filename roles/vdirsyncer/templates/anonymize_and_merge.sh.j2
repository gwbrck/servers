#!/usr/bin/env bash
set -euo pipefail

EXCHANGE_DIR="/var/lib/vdirsyncer/local_exchange"
AVAIL_DIR="/var/lib/vdirsyncer/availability"

mkdir -p "$AVAIL_DIR"

python3 - "$EXCHANGE_DIR" "$AVAIL_DIR" <<'PY'
import pathlib, re, sys

src_ex = pathlib.Path(sys.argv[1])
avail_dir = pathlib.Path(sys.argv[2])

STRIP = re.compile(
    r"^(SUMMARY|DESCRIPTION|LOCATION|ATTENDEE|ORGANIZER)"
    r"[:;].*(?:\r?\n[ \t].*)*\r?\n?",
    re.MULTILINE,
)
UID_RE = re.compile(r"^UID[:;](.*?)$", re.MULTILINE)
VEVENT_RE = re.compile(
    r"BEGIN:VEVENT\r?\n.*?END:VEVENT\r?\n", re.DOTALL
)
CANCEL_RE = re.compile(r"^STATUS:CANCELLED\s*$", re.MULTILINE)

def anonymize_vevent(vevent, new_uid):
    vevent = UID_RE.sub(f"UID:{new_uid}", vevent)
    vevent = STRIP.sub("", vevent)
    vevent = re.sub(
        r"(BEGIN:VEVENT\r?\n)",
        "\\1SUMMARY:Arbeitstermin\r\n",
        vevent,
    )
    return vevent

def process_source(prefix, src, out_dir):
    expected = set()
    for ics in src.rglob("*.ics"):
        content = ics.read_bytes().decode("utf-8")
        content = content.replace("\r\n", "\n").replace("\n", "\r\n")

        if re.search(r"^METHOD:CANCEL\s*$", content, re.MULTILINE):
            continue

        uid_match = UID_RE.search(content)
        original_uid = uid_match.group(1).strip() if uid_match else ics.stem
        new_uid = f"avail-{prefix}_{original_uid}"

        vevents = VEVENT_RE.findall(content)
        vevents = [e for e in vevents if not CANCEL_RE.search(e)]

        if not vevents:
            continue

        header_match = re.match(r"^(.*?)(?=BEGIN:VEVENT)", content, re.DOTALL)
        header = header_match.group(0) if header_match else "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Anonymize//EN\r\n"
        footer = "END:VCALENDAR\r\n"

        cleaned = header + "".join(anonymize_vevent(e, new_uid) for e in vevents) + footer
        cleaned = re.sub(r"\r?\n\r?\n+", "\r\n", cleaned)

        name = f"{prefix}_{original_uid}.ics"
        expected.add(name)
        (out_dir / name).write_bytes(cleaned.encode("utf-8"))

    return expected

def cleanup_dir(out_dir, expected):
    for old in list(out_dir.glob("*.ics")):
        if old.name not in expected:
            old.unlink()

expected = process_source("ex", src_ex, avail_dir)
cleanup_dir(avail_dir, expected)
PY
