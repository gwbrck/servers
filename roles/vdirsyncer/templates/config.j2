[general]
status_path = "/var/lib/vdirsyncer/.vdirsyncer/status/"

[storage exchange]
type = "caldav"
url = "{{ sops.vdirsyncer.exchange.url }}"
username = "{{ sops.vdirsyncer.exchange.username | replace('\\', '\\\\') }}"
password.fetch = ["command", "printenv", "EXCHANGE_PASS"]
read_only = true

[storage datashare]
type = "caldav"
url = "{{ sops.vdirsyncer.datashare.url }}"
username = "{{ sops.vdirsyncer.datashare.username }}"
password.fetch = ["command", "printenv", "DATASHARE_PASS"]

[storage local_exchange]
type = "filesystem"
path = "/var/lib/vdirsyncer/local_exchange/"
fileext = ".ics"

[storage availability]
type = "filesystem"
path = "/var/lib/vdirsyncer/availability/"
fileext = ".ics"

[pair exchange_to_local]
a = "exchange"
b = "local_exchange"
collections = null
conflict_resolution = "a wins"

[pair availability_to_datashare]
a = "availability"
b = "datashare"
collections = [["availability_to_datashare", null, null]]
conflict_resolution = "a wins"
